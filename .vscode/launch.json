{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "OHOS Ort Model Full Debug",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/installed/ort_ohos_riscv64_debug/bin/ort_models",
      "args": [],
      "cwd": "${workspaceFolder}",
      "stopAtEntry": true,
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb-multiarch",
      "miDebuggerServerAddress": "localhost:41216",
      "preLaunchTask": "ort-ohos-full-debug-sequence",
      "postDebugTask": "ort-ohos-close-debug",
      "environment": [],
      "additionalSOLibSearchPath": "${workspaceFolder}/installed/ort_ohos_riscv64_debug/lib:/data/local/tmp/ort/lib",
      "sourceFileMap": {
        "/data/local/tmp/ort/bin": "${workspaceFolder}/installed/ort_ohos_riscv64_debug/bin",
        "/data/local/tmp/ort/lib": "${workspaceFolder}/installed/ort_ohos_riscv64_debug/lib",
        "/data/local/tmp/ort": "${workspaceFolder}/installed/ort_ohos_riscv64_debug"
      },
      "setupCommands": [
        {"text": "-enable-pretty-printing","description": "Pretty printing","ignoreFailures": true},
        {"text": "set print object on","ignoreFailures": true},
        {"text": "set sysroot ${workspaceFolder}/tools/ohos_ndk/sysroot","ignoreFailures": false},
        {"text": "set architecture riscv:rv64","ignoreFailures": false},
        {"text": "set auto-solib-add on","ignoreFailures": true},
        {"text": "directory ${workspaceFolder}/onnxruntime"}
      ]
    },
