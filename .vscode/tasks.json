{
  "version": "2.0.0",
  "tasks": [
    // ===================== Linux RISC-V64 Remote Debug =====================
    {
      "label": "rv64-set-env",
      "type": "shell",
      "command": "bash",
      "problemMatcher": [],
      "options": { "env": { "BOARD_HOST": "wayne@musepipro", "BOARD_DEPLOY_DIR": "/home/wayne/ort" } },
      "args": ["-c","echo Using $BOARD_HOST target at $BOARD_DEPLOY_DIR"]
    },
    // ONNX Runtime
    {
      "label": "rv64-build-runtime-debug",
      "type": "shell",
      "command": "python3",
      "args": [
        "tools/ci_build/build.py",
        "--rv64",
        "--riscv_toolchain_root","/home/wayne/Workspace/spacemit/spacemit-toolchain-linux-glibc-x86_64-v1.1.2",
        "--build_dir","build/bianbu_riscv64",
        "--config","Debug",
        "--update","--build",
        "--parallel","8",
        "--build_shared_lib",
        "--riscv_march","rv64gcv",
        "--skip_tests"
      ],
      "dependsOn": ["rv64-set-env"],
      "problemMatcher": [],
      "presentation": {"reveal": "always", "panel": "shared"}
    },
    {
      "label": "rv64-install-runtime-debug",
      "type": "shell",
      "command": "cmake",
      "args": [
        "--install","build/bianbu_riscv64/Debug",
        "--prefix","installed/ort_bianbu_rv64_debug"
      ],
      "dependsOn": ["rv64-build-runtime-debug"],
      "problemMatcher": [],
      "presentation": {"reveal": "always", "panel": "shared"}
    },
    // ort_models
    {
      "label": "rv64-configure-ort-models",
      "type": "shell",
      "command": "cmake",
      "args": [
        "-S","samples/ort_models",
        "-B","build/bianbu_models",
        "-DORT_ROOT=${workspaceFolder}",
        "-DORT_BUILD_DIR=${workspaceFolder}/build/bianbu_riscv64/Debug",
        "-DCMAKE_BUILD_TYPE=Debug"
      ],
      "dependsOn": ["rv64-install-runtime-debug"],
      "problemMatcher": [],
      "presentation": {"reveal": "silent", "panel": "shared"}
    },
    {
      "label": "rv64-build-ort-models",
      "type": "shell",
      "command": "cmake",
      "args": ["--build","build/bianbu_models","-j","4"],
      "dependsOn": ["rv64-configure-ort-models"],
      "problemMatcher": [],
      "presentation": {"reveal": "always", "panel": "shared"}
    },
    {
      "label": "rv64-install-ort-models",
      "type": "shell",
      "command": "cmake",
      "args": ["--install","build/bianbu_models","--prefix","installed/ort_bianbu_rv64_debug"],
      "dependsOn": ["rv64-build-ort-models"],
      "problemMatcher": [],
      "presentation": {"reveal": "always", "panel": "shared"}
    },
    // deploy
    {
      "label": "rv64-install-tests-into-prefix",
      "type": "shell",
      "command": "bash",
      "args": ["-c","cp build/bianbu_riscv64/Debug/onnxruntime_test_all installed/ort_bianbu_rv64_debug/bin/ 2>/dev/null || true"],
      "dependsOn": ["rv64-install-runtime-debug"],
      "problemMatcher": [],
      "presentation": {"reveal": "silent", "panel": "shared"}
    },
    {
      "label": "rv64-build-deploy",
      "type": "shell",
      "command": "bash",
      "dependsOn": ["rv64-install-runtime-debug", "rv64-install-ort-models", "rv64-install-tests-into-prefix"],
      "args": [
        "-c",
        "rsync -az --delete installed/ort_bianbu_rv64_debug/ $BOARD_HOST:$BOARD_DEPLOY_DIR/"
      ],
      "problemMatcher": []
    },
    // Start gdbserver for ort_models (e.g., resnet)
    {
      "label": "rv64-start-gdbserver-resnet",
      "type": "shell",
      "command": "bash",
      "dependsOn": ["rv64-close-debug"],
      "args": [
        "-c",
        "ssh $BOARD_HOST 'cd $BOARD_DEPLOY_DIR/bin && LD_LIBRARY_PATH=$BOARD_DEPLOY_DIR/lib gdbserver :41217 ./ort_models --model resnet --image ../assets/images/EdlNaRhg9ik.jpg'"
      ],
      "isBackground": true,
      "problemMatcher": [{
        "pattern": [{"regexp": ".","file":1,"location":2,"message":3}],
        "background": {"activeOnStart": true, "beginsPattern": "Listening on port", "endsPattern": "Listening on port 41217"}
      }]
    },
    // Start gdbserver for ort_models (YOLO)
    {
      "label": "rv64-start-gdbserver-yolo",
      "type": "shell",
      "command": "bash",
      "dependsOn": ["rv64-close-debug"],
      "args": [
        "-c",
        "ssh $BOARD_HOST 'cd $BOARD_DEPLOY_DIR/bin && LD_LIBRARY_PATH=$BOARD_DEPLOY_DIR/lib gdbserver :41217 ./ort_models --model yolo --image ../assets/images/EdlNaRhg9ik.jpg --yolo-thresh 0.25 --yolo-nms 0.45'"
      ],
      "isBackground": true,
      "problemMatcher": [{
        "pattern": [{"regexp": ".","file":1,"location":2,"message":3}],
        "background": {"activeOnStart": true, "beginsPattern": "Listening on port", "endsPattern": "Listening on port 41217"}
      }]
    },
    // Start gdbserver for onnxruntime_test_all
    {
      "label": "rv64-start-gdbserver-test-all",
      "type": "shell",
      "command": "bash",
      "dependsOn": ["rv64-close-debug"],
      "args": [
        "-c",
        "ssh $BOARD_HOST 'cd $BOARD_DEPLOY_DIR/bin && LD_LIBRARY_PATH=$BOARD_DEPLOY_DIR/lib gdbserver :41217 ./onnxruntime_test_all'"
      ],
      "isBackground": true,
      "problemMatcher": [{
        "pattern": [{"regexp": ".","file":1,"location":2,"message":3}],
        "background": {"activeOnStart": true, "beginsPattern": "Listening on port", "endsPattern": "Listening on port 41217"}
      }]
    },
    {
      "label": "rv64-close-debug",
      "type": "shell",
      "command": "bash",
      "args": ["-c","ssh $BOARD_HOST 'pkill -f gdbserver || true'"],
      "problemMatcher": []
    },

    // ===================== OHOS RISC-V64 Remote Debug =====================
    // 1. Build ONNX Runtime (Debug, shared lib)
    {
      "label": "ort-ohos-build-runtime",
      "type": "shell",
      "command": "python3",
      "args": [
        "tools/ci_build/build.py",
        "--ohos","--ohos_arch","riscv64","--ohos_ndk_root","tools/ohos_ndk",
        "--build_dir","build/ohos_riscv64",
        "--config","Debug",
        "--update","--build",
        "--parallel","9",
        "--cmake_extra_defines","onnxruntime_BUILD_SHARED_LIB=ON"
      ],
      "problemMatcher": [],
      "group": {"kind": "build", "isDefault": true},
      "presentation": {"reveal": "always","panel": "shared"}
    },
    // 2. Install runtime to installed/ prefix
    {
      "label": "ort-ohos-install-runtime-debug",
      "type": "shell",
      "command": "cmake",
      "args": ["--install","build/ohos_riscv64/Debug","--prefix","installed/ort_ohos_riscv64_debug"],
      "dependsOn": ["ort-ohos-build-runtime"],
      "problemMatcher": [],
      "presentation": {"reveal": "always","panel":"shared"}
    },
  // 3. Configure sample models project (depends on runtime build for headers/libs)
    {
      "label": "ort-ohos-configure-models",
      "type": "shell",
      "command": "cmake",
      "args": [
        "-S","samples/ort_models",
        "-B","build/ohos_models",
        "-DCMAKE_TOOLCHAIN_FILE=${workspaceFolder}/cmake/ohos_riscv64.toolchain.cmake",
        "-DORT_ROOT=${workspaceFolder}",
        "-DCMAKE_BUILD_TYPE=Debug",
        "-DORT_BUILD_DIR=${workspaceFolder}/build/ohos_riscv64/Debug"
      ],
      "dependsOn": ["ort-ohos-build-runtime"],
      "problemMatcher": [],
      "presentation": {"reveal":"silent","panel":"shared"}
    },
    // 4. Build sample models binary
    {
      "label": "ort-ohos-build-models",
      "type": "shell",
      "command": "cmake",
      "args": ["--build","build/ohos_models","-j","4"],
      "dependsOn": ["ort-ohos-configure-models"],
      "problemMatcher": [],
      "presentation": {"reveal":"always","panel":"shared"}
    },
    // 5. Install models binary & models into same prefix
    {
      "label": "ort-ohos-install-models-debug",
      "type": "shell",
      "command": "cmake",
      "args": ["--install","build/ohos_models","--prefix","installed/ort_ohos_riscv64_debug"],
      "dependsOn": ["ort-ohos-build-models"],
      "problemMatcher": [],
      "presentation": {"reveal":"always","panel":"shared"}
    },
    // Convenience meta task: build+install everything
    {
      "label": "ort-ohos-install-all-debug",
      "dependsOrder": "sequence",
      "dependsOn": [
        "ort-ohos-install-runtime-debug",
        "ort-ohos-install-models-debug"
      ]
    },
    // 6. Copy test executables & testdata into install prefix (so they get deployed together)
    {
      "label": "ort-ohos-install-tests-into-prefix",
      "type": "shell",
      "command": "bash",
      "args": ["tools/scripts/ohos/install_tests_into_prefix.sh"],
      "dependsOn": ["ort-ohos-install-all-debug"],
      "problemMatcher": [],
      "presentation": {"reveal":"silent","panel":"shared"}
    },
    // 7. Deploy installed tree to device (tar sync)
    {
      "label": "ort-ohos-deploy-installed-all",
      "type": "shell",
      "command": "bash",
      "args": ["tools/scripts/ohos/deploy_installed_all.sh"],
      "dependsOn": ["ort-ohos-install-tests-into-prefix"],
      "problemMatcher": [],
      "presentation": {"reveal":"always","panel":"shared"}
    },
    // 8. Port forward for gdbserver
    {
      "label": "ort-ohos-port-forward",
      "type": "shell",
      "command": "hdc",
      "args": ["fport","tcp:41216","tcp:41216"],
      "problemMatcher": [],
      "presentation": {"reveal":"silent"}
    },
  // 9. Stop any stale gdbserver
    {
      "label": "ort-ohos-stop-gdbserver",
      "type": "shell",
      "command": "hdc",
      "args": ["shell","pkill -f gdbserver || true"],
      "problemMatcher": []
    },
    // 10. Start gdbserver (ResNet only)
    {
      "label": "ort-ohos-start-gdbserver-models-resnet",
      "type": "shell",
      "command": "hdc",
      "args": ["shell","cd /data/local/tmp/ort/bin && LD_LIBRARY_PATH=/data/local/tmp/ort/lib /data/local/tmp/gdbserver :41216 ./ort_models --model resnet --image ../assets/images/EdlNaRhg9ik.jpg"],
      "isBackground": true,
      "problemMatcher": [{
        "pattern": [{"regexp": ".","file":1,"location":2,"message":3}],
        "background": {"activeOnStart": true, "beginsPattern": "Listening on port", "endsPattern": "Listening on port 41216"}
      }]
    },
    {
      "label": "ort-ohos-quick-start-models-resnet",
      "dependsOrder": "sequence",
      "dependsOn": [
        "ort-ohos-port-forward",
        "ort-ohos-start-gdbserver-models-resnet"
      ]
    },
    // 11. Start gdbserver (YOLO only)
    {
      "label": "ort-ohos-start-gdbserver-models-yolo",
      "type": "shell",
      "command": "hdc",
      "args": ["shell","cd /data/local/tmp/ort/bin && LD_LIBRARY_PATH=/data/local/tmp/ort/lib /data/local/tmp/gdbserver :41216 ./ort_models --model yolo --image ../assets/images/EdlNaRhg9ik.jpg --yolo-thresh 0.25 --yolo-nms 0.45"],
      "isBackground": true,
      "problemMatcher": [{
        "pattern": [{"regexp": ".","file":1,"location":2,"message":3}],
        "background": {"activeOnStart": true, "beginsPattern": "Listening on port", "endsPattern": "Listening on port 41216"}
      }]
    },
    {
      "label": "ort-ohos-quick-start-models-yolo",
      "dependsOrder": "sequence",
      "dependsOn": [
        "ort-ohos-port-forward",
        "ort-ohos-start-gdbserver-models-yolo"
      ]
    },
    // 12. Close debug (cleanup)
    {
      "label": "ort-ohos-stop-forward",
      "type": "shell",
      "command": "hdc",
      "args": ["fport","rm","tcp:41216","tcp:41216"],
      "problemMatcher": []
    },
    {
      "label": "ort-ohos-close-debug",
      "dependsOrder": "sequence",
      "dependsOn": ["ort-ohos-stop-gdbserver","ort-ohos-stop-forward"],
      "problemMatcher": []
    },
    // 13. Clean helper
    {
      "label": "ort-ohos-clean",
      "type": "shell",
      "command": "bash",
      "args": ["-c","rm -rf build/ohos_models build/ohos_riscv64 installed/ort_ohos_riscv64_debug build/ort_sync_stage build/ort_sync_stage.tar.gz"],
      "problemMatcher": []
    },

    // 14. onnxruntime official test
    {
      "label": "ort-ohos-start-gdbserver-test-all",
      "type": "shell",
      "command": "hdc",
      "args": ["shell","cd /data/local/tmp/ort && LD_LIBRARY_PATH=/data/local/tmp/ort/lib /data/local/tmp/gdbserver :41216 ./bin/onnxruntime_test_all"],
      "isBackground": true,
      "problemMatcher": [{
        "pattern": [{"regexp": ".","file":1,"location":2,"message":3}],
        "background": {"activeOnStart": true, "beginsPattern": "Listening on port", "endsPattern": "Listening on port 41216"}
      }]
    },
    // Quick sequence (test all)
    {
      "label": "ort-ohos-quick-start-test-all",
      "dependsOrder": "sequence",
      "dependsOn": [
        "ort-ohos-port-forward",
        "ort-ohos-start-gdbserver-test-all"
      ]
    },
    // Full sequence for one-click debug (test all)
    {
      "label": "ort-ohos-full-debug-test-all",
      "dependsOrder": "sequence",
      "dependsOn": [
        "ort-ohos-install-all-debug",
        "ort-ohos-install-tests-into-prefix",
        "ort-ohos-deploy-installed-all",
        "ort-ohos-port-forward",
        "ort-ohos-start-gdbserver-test-all"
      ]
    }
    //     {
    //   "label": "ort-ohos-quick-start-test-fail",
    //   "dependsOrder": "sequence",
    //   "dependsOn": [
    //     "ort-ohos-port-forward",
    //     "ort-ohos-start-gdbserver-test-fail"
    //   ]
    // },
    // {
    //   "label": "ort-ohos-start-gdbserver-test-fail",
    //   "type": "shell",
    //   "command": "hdc",
    //   "args": ["shell","cd /data/local/tmp/ort && ORT_DUMP_ACTUAL=1 LD_LIBRARY_PATH=/data/local/tmp/ort/lib /data/local/tmp/gdbserver :41216 ./bin/onnxruntime_test_all --gtest_filter=Random.MultinomialDefaultDType"],
    //   "isBackground": true,
    //   "problemMatcher": [{
    //     "pattern": [{"regexp": ".","file":1,"location":2,"message":3}],
    //     "background": {"activeOnStart": true, "beginsPattern": "Listening on port", "endsPattern": "Listening on port 41216"}
    //   }]
    // },

  ]
}
